# Ignore environment files
.env*

# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
backend/node_modules/
frontend/node_modules/

# Build outputs
backend/dist/
frontend/.next/
frontend/out/

# OS generated files
.DS_Store
Thumbs.db

# IDE and editor folders
.vscode/
.idea/

# Hardhat artifacts and cache
blockchain/artifacts/
blockchain/cache/
blockchain/coverage/

# Misc
*.local
*.env.*.local

# Ignore test coverage
coverage/

# Ignore compiled contracts
blockchain/ignition/deployments/

# Ignore package lock files (optional, if you don't want to commit them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
